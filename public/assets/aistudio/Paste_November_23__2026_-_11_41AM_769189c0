    function downloadJsonBackup() {
      if (!requireAdmin()) return;
      const dataStr = JSON.stringify(db, null, 2);
      const blob = new Blob([dataStr], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `barakah_backup_${getTodayISO()}.json`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      showToast('ব্যাকআপ JSON ফাইল ডাউনলোড হয়েছে');
    }

    function importJsonBackup(event) {
      if (!requireAdmin()) return;
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const parsed = JSON.parse(e.target.result);
          if (!parsed || !Array.isArray(parsed.members)) {
            showToast('সঠিক ব্যাকআপ ফাইল নয়!');
            return;
          }
          db = ensureDbStructure(parsed);
          saveDatabase();
          showToast('ব্যাকআপ সফলভাবে রিস্টোর হয়েছে!');
          render();
        } catch (err) {
          showToast('ফাইলটি পড়া যায়নি!');
        }
      };
      reader.readAsText(file);
    }

