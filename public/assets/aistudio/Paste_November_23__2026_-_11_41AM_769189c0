    // Pull-Down (Pull to Refresh) — যেই পেজে আছে শুধুমাত্র সেই পেজই আপডেট করবে
    (function initPullToRefresh() {
      let startY = 0;
      let pulling = false;
      let currentDiff = 0;
      const threshold = 72;

      function getPtrEl() {
        return document.getElementById('ptr-indicator');
      }

      document.addEventListener('touchstart', (e) => {
        if (window.scrollY > 2) return;
        if (e.target.closest('input, textarea, select, .modal-box, .bulk-member-list, .ai-chat-box, .table-wrap')) return;
        startY = e.touches[0].clientY;
        pulling = true;
        currentDiff = 0;
      }, { passive: true });

      document.addEventListener('touchmove', (e) => {
        if (!pulling) return;
        const diff = e.touches[0].clientY - startY;
        if (diff <= 0 || window.scrollY > 2) {
          currentDiff = 0;
          const el = getPtrEl();
          if (el) el.classList.remove('visible');
          return;
        }
        currentDiff = Math.min(diff, 120);
        if (currentDiff > 18) {
          const el = getPtrEl();
          if (el) {
            el.classList.add('visible');
            const progress = Math.min(currentDiff / threshold, 1);
            el.style.transform = `translateX(-50%) translateY(${(progress - 1) * 100}%)`;
            el.textContent = currentDiff >= threshold
              ? '🔄 ছেড়ে দিন — শুধুমাত্র এই পেজটি আপডেট হবে'
              : '⬇️ নিচে টানুন আপডেট করতে...';
          }
        }
      }, { passive: true });

      document.addEventListener('touchend', async () => {
        if (!pulling) return;
        pulling = false;
        const el = getPtrEl();
        if (currentDiff >= threshold) {
          if (el) {
            el.style.transform = 'translateX(-50%) translateY(0%)';
            el.textContent = '🔄 বর্তমান পেজ আপডেট হচ্ছে...';
          }
          await refreshCurrentPageOnly();
          setTimeout(() => {
            if (el) {
              el.classList.remove('visible');
              el.style.transform = 'translateX(-50%) translateY(-100%)';
            }
          }, 450);
        } else if (el) {
          el.classList.remove('visible');
          el.style.transform = 'translateX(-50%) translateY(-100%)';
        }
        currentDiff = 0;
      }, { passive: true });
    })();

    async function refreshCurrentPageOnly() {
