                  <option value="openai" ${cfg.aiProvider === 'openai' ? 'selected' : ''}>OpenAI</option>
                </select>
              </div>
              <div class="form-group">
                <label>API Key</label>
                <input type="password" id="ai-api-key-input" class="form-control" value="${escapeHtml(cfg.aiApiKey || '')}" placeholder="ঐচ্ছিক API Key" />
              </div>
            </div>
            <button class="btn btn-outline" onclick="saveAiApiConfig()">💾 API সেভ করুন</button>
          </div>
        `;
      } else if (currentView.adminTab === 'bulk') {
        const memberChecks = db.members.map(m => `
          <label class="bulk-member-item">
            <input type="checkbox" class="bulk-member-cb" value="${m.id}" onchange="updateBulkPreview()" />
            <span>${toBn(m.id)}. ${escapeHtml(m.name)} <small style="color:var(--muted);">(৳${toBn(getMemberTotal(m))})</small></span>
          </label>
        `).join('');

        tabContent = `
          <div class="card">
            <div class="card-title">📅 তারিখ রেঞ্জ অনুযায়ী ডিপোজিট আদায়</div>
            <p style="font-size:12.5px; color:var(--muted); margin-bottom:10px;">
              যেমন: ১১/২২/২৬ থেকে ১১/২৯/২৬ পর্যন্ত এক বা একাধিক সদস্যের ডিপোজিট একসাথে আদায় করুন।
            </p>
            <div class="btn-row">
              <div class="form-group">
                <label>শুরুর তারিখ</label>
                <input type="date" id="bulk-start" class="form-control" value="2026-11-22" oninput="updateBulkPreview()" />
              </div>
              <div class="form-group">
                <label>শেষ তারিখ</label>
                <input type="date" id="bulk-end" class="form-control" value="2026-11-29" oninput="updateBulkPreview()" />
              </div>
            </div>
            <div class="btn-row">
              <div class="form-group">
                <label>প্রতিদিনের টাকা</label>
                <input type="number" id="bulk-amount" class="form-control" value="100" min="1" inputmode="numeric" oninput="updateBulkPreview()" />
              </div>
              <div class="form-group">
                <label>মন্তব্য</label>
                <input type="text" id="bulk-note" class="form-control" value="দৈনিক কিস্তি" />
              </div>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
              <span style="font-size:13px; font-weight:700; color:var(--muted);">সদস্য নির্বাচন করুন:</span>
              <div style="display:flex; gap:6px;">
                <button type="button" class="mini-pill-btn mini-pill-login" onclick="toggleAllBulkMembers(true)">সবাই</button>
                <button type="button" class="mini-pill-btn" style="background:#e2e8f0; color:#0f172a;" onclick="toggleAllBulkMembers(false)">বাদ দিন</button>
              </div>
            </div>
            <div class="bulk-member-list">${memberChecks}</div>
            <label class="checkbox-row">
              <input type="checkbox" id="bulk-skip-dup" checked />
              <span>আগে জমা থাকা তারিখ বাদ দিন</span>
            </label>
            <div class="range-preview" id="bulk-preview-box">
              সদস্য টিক দিলে মোট হিসাব দেখা যাবে
            </div>
            <button class="btn btn-primary" onclick="applyBulkRangeDeposits()">✅ নির্বাচিত সদস্যদের ডিপোজিট আদায় করুন</button>
          </div>
        `;
      } else if (currentView.adminTab === 'json') {
        tabContent = `
          <div class="card">
            <div class="card-title">💻 লাইভ ডেটাবেজ কোডিং (JSON)</div>
            <textarea id="admin-json-editor" class="code-textarea">${escapeHtml(JSON.stringify(db, null, 2))}</textarea>
            <div style="margin-top:10px;">
              <button class="btn btn-primary" onclick="saveAdminJsonCode()">💾 কোড সেভ ও আপডেট করুন</button>
            </div>
          </div>
        `;
      } else if (currentView.adminTab === 'html') {
        const fullCode = generateFullUpdatedHtmlCode();
        tabContent = `
          <div class="card">
            <div class="card-title">📄 সম্পূর্ণ অ্যাপ কোড (HTML)</div>
            <p style="font-size:12.5px; color:var(--muted); margin-bottom:10px;">
              সব নতুন হিসাব ও AI ফিচারসহ আপডেটেড HTML কোড। এটি শেয়ার বা হোস্ট করলে সবার অ্যাপ অটো আপডেট হবে।
            </p>
            <textarea id="admin-html-viewer" class="code-textarea" readonly>${escapeHtml(fullCode)}</textarea>
            <div class="btn-row" style="margin-top:10px;">
              <button class="btn btn-accent" onclick="copyFullHtmlCode()">📋 কোড কপি</button>
              <button class="btn btn-success" onclick="downloadUpdatedHtml()">📲 HTML ডাউনলোড</button>
            </div>
          </div>
        `;
      } else {
        tabContent = `
          <div class="card">
            <div class="card-title">🌐 রিয়েল-টাইম ক্লাউড অটো-আপডেট (ঐচ্ছিক)</div>
            <p style="font-size:12.5px; color:var(--muted); margin-bottom:10px; line-height:1.5;">
              ফ্রি Firebase Realtime DB-এর <code>.json</code> লিংক এখানে বসালে সকল ইউজারের অ্যাপে অটো-আপডেট চলে যাবে:
            </p>
            <div class="form-group">
              <label>ক্লাউড সিঙ্ক JSON URL</label>
              <input type="url" id="cloud-sync-url" class="form-control" value="${escapeHtml(db.cloudSyncUrl || '')}" placeholder="https://example.firebaseio.com/barakah.json" />
            </div>
            <div class="btn-row">
              <button class="btn btn-primary" onclick="saveCloudUrl()">💾 লিংক সেভ</button>
              <button class="btn btn-accent" onclick="pushToCloud(false)">☁️ এখনই সিঙ্ক</button>
            </div>
          </div>

          <div class="card">
            <div class="card-title">🔑 এডমিন নাম ও পিন পরিবর্তন</div>
            <div class="form-group">
              <label>এডমিনের নাম</label>
              <input type="text" id="new-admin-name" class="form-control" value="${escapeHtml(db.adminName || 'Shohag Hossain')}" />
            </div>
            <div class="form-group">
              <label>নতুন এডমিন পিন</label>
              <input type="text" id="new-admin-pin" class="form-control" value="${escapeHtml(db.adminPin || '@Shohag007')}" />
            </div>
            <button class="btn btn-primary" onclick="updateAdminSettings()">সেটিংস আপডেট করুন</button>
          </div>

          <div class="card">
            <div class="card-title">⚠️ ডেটা রিসেট</div>
            <button class="btn btn-danger" onclick="resetAllData()">🗑️ সব হিসাব শুরু অবস্থায় ফিরিয়ে নিন</button>
          </div>
        `;
      }

      return `
        <header class="page-header" style="background: #1e293b;">
          <button class="back-btn" onclick="goBack()">← ব্যাক</button>
          <div class="page-title">⚙️ এডমিন প্যানেল</div>
          <button class="back-btn" style="background:#dc2626; border-color:#ef4444;" onclick="adminLogout()">লগআউট</button>
        </header>

        <div class="content-pad">
          <div class="admin-tabs">
            <button class="tab-btn ai-tab ${currentView.adminTab === 'ai' ? 'active' : ''}" onclick="switchAdminTab('ai')">🤖 AI অ্যাসিস্ট্যান্ট</button>
            <button class="tab-btn ${currentView.adminTab === 'bulk' ? 'active' : ''}" onclick="switchAdminTab('bulk')">📅 রেঞ্জ ডিপোজিট</button>
            <button class="tab-btn ${currentView.adminTab === 'html' ? 'active' : ''}" onclick="switchAdminTab('html')">📲 HTML</button>
            <button class="tab-btn ${currentView.adminTab === 'json' ? 'active' : ''}" onclick="switchAdminTab('json')">💻 JSON</button>
            <button class="tab-btn ${currentView.adminTab === 'settings' ? 'active' : ''}" onclick="switchAdminTab('settings')">⚙️ সেটিংস</button>
          </div>

          ${tabContent}
        </div>
      `;
    }

    function switchAdminTab(tab) {
      currentView.adminTab = tab;
      persistViewState();
      render();
    }

    function toggleAllBulkMembers(checked) {
      document.querySelectorAll('.bulk-member-cb').forEach(cb => cb.checked = checked);
      updateBulkPreview();
    }

    function updateBulkPreview() {
      const startISO = document.getElementById('bulk-start')?.value;
      const endISO = document.getElementById('bulk-end')?.value;
      const amt = Number(document.getElementById('bulk-amount')?.value || 0);
      const selectedCount = document.querySelectorAll('.bulk-member-cb:checked').length;
      const dates = getDatesInRange(startISO, endISO);
      const box = document.getElementById('bulk-preview-box');
      if (!box) return;
      if (!dates.length) {
        box.innerHTML = '⚠️ সঠিক শুরুর ও শেষ তারিখ নির্বাচন করুন';
        return;
      }
      if (!selectedCount) {
        box.innerHTML = `📅 ${formatDateBn(startISO)} — ${formatDateBn(endISO)} (${toBn(dates.length)} দিন)<br>উপরের তালিকা থেকে কমপক্ষে ১ জন সদস্য টিক দিন`;
        return;
      }
      const total = selectedCount * dates.length * amt;
      box.innerHTML = `👥 নির্বাচিত: <b>${toBn(selectedCount)} জন</b> • <b>${toBn(dates.length)} দিন</b> (${formatDateBn(startISO)} — ${formatDateBn(endISO)})<br>আনুমানিক মোট আদায়: <b>৳ ${toBn(total)}</b>`;
    }

    function applyBulkRangeDeposits() {
      if (!requireAdmin()) return;
      const startISO = document.getElementById('bulk-start').value;
      const endISO = document.getElementById('bulk-end').value;
      const amt = Number(document.getElementById('bulk-amount').value);
      const note = document.getElementById('bulk-note').value.trim() || 'দৈনিক কিস্তি';
      const skipDup = document.getElementById('bulk-skip-dup').checked;

      const selectedIds = Array.from(document.querySelectorAll('.bulk-member-cb:checked')).map(cb => Number(cb.value));
      const dates = getDatesInRange(startISO, endISO);

      if (!selectedIds.length) {
        showToast('কমপক্ষে ১ জন সদস্য নির্বাচন করুন');
        return;
      }
      if (!dates.length) {
        showToast('সঠিক তারিখ রেঞ্জ নির্বাচন করুন');
        return;
      }
      if (!amt || amt <= 0) {
        showToast('সঠিক টাকার পরিমাণ লিখুন');
        return;
      }

      let totalEntries = 0;
      selectedIds.forEach(mId => {
        const member = db.members.find(m => m.id === mId);
        if (!member) return;
        const existingDates = new Set((member.deposits || []).map(d => d.date));
        dates.forEach((dStr, idx) => {
          if (skipDup && existingDates.has(dStr)) return;
          member.deposits.push({
            id: 'd_' + Date.now() + '_' + mId + '_' + idx + '_' + Math.floor(Math.random() * 1000),
            date: dStr,
            amount: amt,
            note
          });
          totalEntries++;
        });
      });

      if (totalEntries === 0) {
        showToast('নির্বাচিত তারিখগুলোতে আগেই জমা রয়েছে!');
        return;
      }

      saveDatabase();
      showToast(`মোট ${toBn(totalEntries)}টি কিস্তি (৳${toBn(totalEntries * amt)}) সফলভাবে আদায় হয়েছে!`);
      render();
    }

    function saveAdminJsonCode() {
      if (!requireAdmin()) return;
      try {
        const raw = document.getElementById('admin-json-editor').value;
        const parsed = JSON.parse(raw);
        if (!parsed || !Array.isArray(parsed.members)) {
          showToast('কোডে ভুল আছে! members তালিকা থাকতে হবে।');
          return;
        }
        db = ensureDbStructure(parsed);
        saveDatabase();
        showToast('কোডিং থেকে ডেটা আপডেট হয়েছে!');
        render();
      } catch (e) {
        showToast('JSON কোড সিনট্যাক্স সঠিক নয়!');
      }
    }

    function copyTextSafe(text, successMsg) {
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(() => {
          showToast(successMsg);
        }).catch(() => fallbackCopy(text, successMsg));
      } else {
        fallbackCopy(text, successMsg);
      }
    }

    function fallbackCopy(text, successMsg) {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.focus();
      ta.select();
      try {
        document.execCommand('copy');
        showToast(successMsg);
      } catch (e) {
        showToast('কপি করা যায়নি');
      }
      ta.remove();
    }

    function copyFullHtmlCode() {
      const el = document.getElementById('admin-html-viewer');
      copyTextSafe(el.value, 'সম্পূর্ণ কোড কপি হয়েছে!');
    }

    function downloadUpdatedHtml() {
      if (!requireAdmin()) return;
      saveDatabase();
      const code = generateFullUpdatedHtmlCode();
      const blob = new Blob([code], { type: 'text/html;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `barakah_multicare_${getTodayISO()}.html`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      showToast('আপডেটেড HTML ফাইল ডাউনলোড হয়েছে');
    }

    function saveCloudUrl() {
      if (!requireAdmin()) return;
      db.cloudSyncUrl = document.getElementById('cloud-sync-url').value.trim();
      saveDatabase(true);
      showToast('ক্লাউড সিঙ্ক লিংক সেভ হয়েছে');
    }

    function updateAdminSettings() {
      if (!requireAdmin()) return;
      const newName = document.getElementById('new-admin-name').value.trim();
      const newPin = document.getElementById('new-admin-pin').value.trim();
      if (!newPin || newPin.length < 3) {
        showToast('কমপক্ষে ৩ সংখ্যার পিন দিন');
        return;
      }
      if (newName) db.adminName = newName;
      db.adminPin = newPin;
      saveDatabase();
      showToast('এডমিন সেটিংস আপডেট হয়েছে!');
      render();
    }

    function resetAllData() {
      if (!requireAdmin()) return;
      askConfirm('সতর্কতা: ডিফল্ট অবস্থায় ফিরে গেলে পরবর্তীতে এন্ট্রি করা সব কিস্তি মুছে যাবে! নিশ্চিত?', () => {
        localStorage.removeItem(STORAGE_KEY);
        const defEl = document.getElementById('default-db');
        db = ensureDbStructure(JSON.parse(defEl.textContent));
        saveDatabase();
        showToast('সব ডেটা রিসেট করা হয়েছে');
        render();
      });
    }

    // প্রথমবার রেন্ডার ও ক্লাউড অটো-চেক
    render();
    if (db.cloudSyncUrl) {
      syncFromCloud(true);
      setInterval(() => {
        if (!isAdminAuthenticated) syncFromCloud(true);
      }, 25000);
    }
  </script></body></html>