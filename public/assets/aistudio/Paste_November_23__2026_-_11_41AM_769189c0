    function runLocalSmartAi(promptRaw) {
      const p = (promptRaw || '').trim();
      const lower = toEnDigits(p).toLowerCase();
      const cfg = db.appConfig;
      let actions = [];

      // ১. ডার্ক মোড / লাইট মোড
      if (lower.includes('ডার্ক') || lower.includes('dark') || lower.includes('কালো থিম')) {
        if (lower.includes('বন্ধ') || lower.includes('off')) {
          cfg.darkMode = false;
          actions.push('☀️ ডার্ক মোড বন্ধ করে লাইট মোড চালু করা হয়েছে');
        } else {
          cfg.darkMode = true;
          actions.push('🌙 ডার্ক মোড চালু করা হয়েছে');
        }
      } else if (lower.includes('লাইট মোড') || lower.includes('light mode') || lower.includes('সাদা থিম')) {
        cfg.darkMode = false;
        actions.push('☀️ লাইট মোড চালু করা হয়েছে');
      }

      // ২. থিম কালার পরিবর্তন
      const colorMap = [
        { keys: ['নীল', 'blue'], hex: '#0284c7', name: 'নীল (Blue)' },
        { keys: ['বেগুনি', 'purple', 'violet'], hex: '#7c3aed', name: 'বেগুনি (Purple)' },
        { keys: ['সবুজ', 'green'], hex: '#16a34a', name: 'সবুজ (Green)' },
        { keys: ['লাল', 'red', 'মেরুন'], hex: '#dc2626', name: 'লাল (Red)' },
        { keys: ['গোলাপি', 'pink'], hex: '#db2777', name: 'গোলাপি (Pink)' },
        { keys: ['কমলা', 'orange'], hex: '#ea580c', name: 'কমলা (Orange)' },
        { keys: ['টিল', 'teal', 'আগের কালার', 'ডিফল্ট'], hex: '#0f766e', name: 'টিল (Default)' }
      ];
      const hexMatch = p.match(/#[0-9a-fA-F]{6}/);
      if (hexMatch) {
        cfg.themeColor = hexMatch[0];
        actions.push(`🎨 অ্যাপের প্রাইমারি রঙ ${hexMatch[0]} করা হয়েছে`);
      } else if (lower.includes('থিম') || lower.includes('কালার') || lower.includes('রঙ') || lower.includes('color') || lower.includes('theme')) {
        for (const c of colorMap) {
          if (c.keys.some(k => lower.includes(k))) {
            cfg.themeColor = c.hex;
            actions.push(`🎨 অ্যাপের থিম রঙ "${c.name}" এ আপডেট করা হয়েছে`);
            break;
          }
        }
      }

      // ৩. টপ ডিপোজিটর / লিডারবোর্ড ফিচার
      if (lower.includes('লিডারবোর্ড') || lower.includes('টপ ডিপোজিটর') || lower.includes('শীর্ষ') || lower.includes('leaderboard')) {
        if (lower.includes('বন্ধ') || lower.includes('বাদ') || lower.includes('হাইড') || lower.includes('off')) {
          cfg.showLeaderboard = false;
          actions.push('🏅 শীর্ষ ডিপোজিটর ফিচারটি বন্ধ করা হয়েছে');
        } else {
          cfg.showLeaderboard = true;
          actions.push('🏅 নতুন ফিচার: হোমপেজে "শীর্ষ ডিপোজিটর (টপ ৩)" কার্ড যুক্ত করা হয়েছে!');
        }
      }

      // ৪. ফান্ড টার্গেট প্রগ্রেস বার ফিচার
      if (lower.includes('টার্গেট') || lower.includes('লক্ষ্য') || lower.includes('target')) {
        const nums = toEnDigits(p).match(/\d+/);
        if (lower.includes('বন্ধ') || lower.includes('বাদ') || lower.includes('মুছ')) {
          cfg.fundTarget = 0;
          actions.push('🎯 ফান্ড লক্ষ্যমাত্রা বার সরানো হয়েছে');
        } else if (nums) {
          cfg.fundTarget = Number(nums[0]);
          actions.push(`🎯 নতুন ফিচার: ৳ ${toBn(cfg.fundTarget)} ফান্ড লক্ষ্যমাত্রা প্রগ্রেস বার যুক্ত করা হয়েছে!`);
        } else {
          cfg.fundTarget = 50000;
          actions.push('🎯 নতুন ফিচার: ৳ ৫০,০০০ ফান্ড লক্ষ্যমাত্রা প্রগ্রেস বার যুক্ত করা হয়েছে!');
        }
      }

      // ৫. রানিং বার আপডেট (হোম বা বিকাশ)
      if (lower.includes('রানিং বার') || lower.includes('টিকার') || lower.includes('marquee')) {
        const splitVal = p.split(/[:ঃ=]/).slice(1).join(':').trim();
        if (splitVal) {
          if (lower.includes('বিকাশ') || lower.includes('bkash')) {
            cfg.bkashTickerText = splitVal;
            actions.push(`📱 বিকাশ রানিং বার আপডেট হয়েছে: "${splitVal}"`);
          } else {
            cfg.homeTickerText = splitVal;
            actions.push(`📢 হোম রানিং বার আপডেট হয়েছে: "${splitVal}"`);
          }
        }
      }

      // ৬. নোটিশ / ঘোষণা ব্যানার
      if (lower.includes('নোটিশ') || lower.includes('ঘোষণা') || lower.includes('notice')) {
        if (lower.includes('মুছ') || lower.includes('বন্ধ') || lower.includes('বাদ')) {
          cfg.noticeBanner = '';
          actions.push('📢 নোটিশ ব্যানার সরিয়ে ফেলা হয়েছে');
        } else {
          const splitVal = p.split(/[:ঃ=]/).slice(1).join(':').trim() || p.replace(/নোটিশ|ঘোষণা|দাও|যোগ করো|করো/gi, '').trim();
          if (splitVal) {
            cfg.noticeBanner = splitVal;
            actions.push(`📢 হোমপেজে নতুন নোটিশ ব্যানার যুক্ত হয়েছে: "${splitVal}"`);
          }
        }
      }

      // ৭. বিকাশ নাম্বার পরিবর্তন
      if ((lower.includes('বিকাশ') || lower.includes('bkash')) && (lower.includes('নাম্বার') || lower.includes('নম্বর') || lower.includes('number'))) {
        const phoneMatch = toEnDigits(p).match(/01\d{9}/);
        if (phoneMatch) {
          cfg.bkashNumber = phoneMatch[0];
          actions.push(`💳 বিকাশ পার্সোনাল নাম্বার পরিবর্তন করে ${phoneMatch[0]} করা হয়েছে`);
        }
      }

      // ৮. সদস্য সর্টিং (বেশি জমা আগে / আইডি অনুযায়ী)
      if (lower.includes('সর্ট') || lower.includes('বেশি জমা আগে') || lower.includes('ক্রম')) {
        if (lower.includes('বেশি') || lower.includes('টাকা')) {
          cfg.sortBy = 'amount_desc';
          actions.push('📊 সদস্য তালিকা এখন বেশি জমা অনুযায়ী সাজানো হয়েছে');
        } else {
          cfg.sortBy = 'id';
          actions.push('📊 সদস্য তালিকা আইডি অনুযায়ী সাজানো হয়েছে');
        }
      }

      // ৯. কাস্টম ফিচার কার্ড / উইজেট যোগ বা মোছা
      if (lower.includes('উইজেট মুছ') || lower.includes('ফিচার মুছ') || lower.includes('সব কাস্টম মুছ')) {
        cfg.customWidgets = [];
        cfg.customCss = '';
        actions.push('🧹 সব কাস্টম ফিচার কার্ড ও কাস্টম CSS মুছে ফেলা হয়েছে');
      } else if ((lower.includes('কার্ড') || lower.includes('উইজেট') || lower.includes('তথ্য বক্স')) && p.includes(':')) {
        const afterColon = p.split(/[:ঃ]/).slice(1).join(':').trim();
        const parts = afterColon.split('|');
        const title = (parts[0] || 'বিশেষ তথ্য').trim();
        const body = (parts[1] || parts[0] || '').trim();
        cfg.customWidgets.push({ id: 'w_' + Date.now(), title, body });
        actions.push(`✨ নতুন কার্ড "${title}" হোমপেজে যুক্ত হয়েছে!`);
      }

      // ১০. সবার বা নির্দিষ্ট সদস্যের আজকের ডিপোজিট জমা (প্রোম্পট থেকে)
      if ((lower.includes('জমা') || lower.includes('ডিপোজিট') || lower.includes('কিস্তি')) && (lower.includes('সবাই') || lower.includes('সকল')) && !lower.includes('রানিং')) {
        const amtMatch = toEnDigits(p).match(/\d+/);
        const amt = amtMatch ? Number(amtMatch[0]) : 100;
        if (amt > 0 && amt <= 50000) {
          const today = getTodayISO();
          let count = 0;
          db.members.forEach((m, idx) => {
            m.deposits.push({
              id: 'd_ai_' + Date.now() + '_' + idx,
              date: today,
              amount: amt,
              note: 'AI কমান্ড জমা'
            });
            count++;
          });
          actions.push(`💰 সকল ${toBn(count)} জন সদস্যের নামে আজ (${formatDateBn(today)}) ৳ ${toBn(amt)} জমা করা হয়েছে!`);
        }
      } else if ((lower.includes('জমা') || lower.includes('ডিপোজিট')) && !lower.includes('রানিং') && !lower.includes('টার্গেট')) {
        const amtMatch = toEnDigits(p).match(/\b(\d{2,5})\b/);
        const amt = amtMatch ? Number(amtMatch[1]) : 0;
        const matchedMember = db.members.find(m => lower.includes(m.name.toLowerCase()));
        if (matchedMember && amt > 0) {
          const today = getTodayISO();
          matchedMember.deposits.push({
            id: 'd_ai_' + Date.now(),
            date: today,
            amount: amt,
            note: 'AI কমান্ড জমা'
          });
          actions.push(`✅ "${matchedMember.name}"-এর নামে আজ ৳ ${toBn(amt)} জমা আপডেট হয়েছে!`);
        }
      }

      // ১১. নতুন সদস্য যোগ (প্রোম্পট থেকে)
      if (lower.includes('নতুন সদস্য') || lower.includes('সদস্য যোগ')) {
        const phoneMatch = toEnDigits(p).match(/01\d{9}/);
        if (phoneMatch) {
          const cleanName = p
            .replace(/নতুন সদস্য|সদস্য যোগ|যোগ করো|নাম|ফোন|মোবাইল|[:ঃ-]/gi, ' ')
            .replace(phoneMatch[0], '')
            .replace(/\s+/g, ' ')
            .trim();
          if (cleanName) {
            const nextId = db.members.length ? Math.max(...db.members.map(m => m.id)) + 1 : 1;
            db.members.push({ id: nextId, name: cleanName, phone: phoneMatch[0], deposits: [] });
            actions.push(`👤 নতুন সদস্য "${cleanName}" (${phoneMatch[0]}) #${toBn(nextId)} নম্বরে যুক্ত হয়েছেন!`);
          }
        }
      }

      // ১২. কাস্টম CSS সরাসরি প্রয়োগ
      if (lower.startsWith('css:')) {
        cfg.customCss = p.slice(4).trim();
        actions.push('🎨 কাস্টম CSS স্টাইল অ্যাপে প্রয়োগ করা হয়েছে!');
      }

      return actions;
    }

    async function callExternalAiIfConfigured(promptText) {
      const cfg = db.appConfig;
      const apiKey = (cfg.aiApiKey || '').trim();
      if (!apiKey) return null;

      const systemInstruction = `You are an AI App Updater for "BARAKAH MULTICARE HOSPITAL UNITY" (Bengali mobile savings app).
Given the admin's prompt and current appConfig JSON, return ONLY a valid JSON object (no markdown) with any subset of these keys to update the app live:
- homeTickerText (string)
- bkashTickerText (string)
- bkashNumber (string)
- themeColor (hex string like "#0284c7")
- darkMode (boolean)
- noticeBanner (string)
- showLeaderboard (boolean)
- fundTarget (number)
- sortBy ("id" or "amount_desc")
- customCss (string of valid CSS)
- addWidget ({ "title": "...", "body": "..." })
- replyBn (short Bengali summary of what you updated)
Current appConfig: ${JSON.stringify({
  homeTickerText: cfg.homeTickerText,
  bkashTickerText: cfg.bkashTickerText,
  bkashNumber: cfg.bkashNumber,
  themeColor: cfg.themeColor,
  darkMode: cfg.darkMode,
  noticeBanner: cfg.noticeBanner,
  showLeaderboard: cfg.showLeaderboard,
  fundTarget: cfg.fundTarget,
  sortBy: cfg.sortBy
})}`;

      try {
        let rawText = '';
        if (cfg.aiProvider === 'openai') {
          const res = await fetch('https://api.openai.com/v1/chat/completions', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${apiKey}`
            },
            body: JSON.stringify({
              model: 'gpt-4o-mini',
              messages: [
                { role: 'system', content: systemInstruction },
                { role: 'user', content: promptText }
              ],
              temperature: 0.3
            })
          });
          const data = await res.json();
          rawText = data?.choices?.[0]?.message?.content || '';
        } else {
          const res = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=${encodeURIComponent(apiKey)}`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents: [{ parts: [{ text: systemInstruction + '\n\nAdmin Prompt: ' + promptText }] }]
            })
          });
          const data = await res.json();
          rawText = data?.candidates?.[0]?.content?.parts?.[0]?.text || '';
        }

        const jsonMatch = rawText.match(/\{[\s\S]*\}/);
        if (!jsonMatch) return null;
        const patch = JSON.parse(jsonMatch[0]);
        const applied = [];
        const allowedKeys = ['homeTickerText', 'bkashTickerText', 'bkashNumber', 'themeColor', 'darkMode', 'noticeBanner', 'showLeaderboard', 'fundTarget', 'sortBy', 'customCss'];
        allowedKeys.forEach(k => {
          if (patch[k] !== undefined) {
            cfg[k] = patch[k];
            applied.push(k);
          }
        });
        if (patch.addWidget && patch.addWidget.title) {
          cfg.customWidgets.push({ id: 'w_' + Date.now(), title: patch.addWidget.title, body: patch.addWidget.body || '' });
          applied.push('customWidget');
        }
        return patch.replyBn || (applied.length ? `🤖 AI সফলভাবে আপডেট করেছে: ${applied.join(', ')}` : null);
      } catch (e) {
        return null;
      }
    }

    async function submitAiPrompt(presetText = null) {
      if (!requireAdmin()) return;
      const inputEl = document.getElementById('ai-prompt-input');
      const promptText = (presetText || (inputEl ? inputEl.value : '')).trim();
      if (!promptText) {
        showToast('দয়া করে একটি প্রোম্পট বা নির্দেশনা লিখুন');
        return;
      }

      // Undo স্ন্যাপশট সংরক্ষণ
      aiUndoSnapshot = JSON.stringify(db);

      const btn = document.getElementById('ai-send-btn');
      if (btn) {
        btn.disabled = true;
        btn.textContent = '⏳ AI আপডেট করছে...';
      }

      const localActions = runLocalSmartAi(promptText);
      let reply = '';

      if (localActions.length) {
        reply = localActions.join('\n');
      } else if (db.appConfig.aiApiKey) {
        const extReply = await callExternalAiIfConfigured(promptText);
        if (extReply) reply = extReply;
      }

      if (!reply) {
        reply = '💡 সরাসরি এই প্রোম্পটটি বুঝতে পারিনি। উদাহরণ হিসেবে নিচের কুইক বাটন ব্যবহার করুন অথবা লিখুন:\n• "শীর্ষ ডিপোজিটর ফিচার যোগ করো"\n• "ফান্ড টার্গেট ৫০০০০ করো"\n• "নোটিশ: শুক্রবার মিটিং হবে"\n• "থিম নীল করো" বা "ডার্ক মোড চালু করো"\n• "কার্ড: শিরোনাম | বিস্তারিত"';
      } else {
        saveDatabase();
        showToast('✨ AI অটো-আপডেট সম্পন্ন হয়েছে!');
      }

      logAiChat(promptText, reply);
      saveDatabase();
      if (inputEl && !presetText) inputEl.value = '';
      render();
      setTimeout(() => {
        const box = document.getElementById('ai-chat-box');
        if (box) box.scrollTop = box.scrollHeight;
      }, 60);
    }

    function undoLastAiUpdate() {
      if (!requireAdmin() || !aiUndoSnapshot) {
        showToast('আগের কোনো AI পরিবর্তন পাওয়া যায়নি');
        return;
      }
      db = ensureDbStructure(JSON.parse(aiUndoSnapshot));
      aiUndoSnapshot = null;
      saveDatabase();
      showToast('↩️ সর্বশেষ AI আপডেট বাতিল করা হয়েছে');
      render();
    }

