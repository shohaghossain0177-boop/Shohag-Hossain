    function buildRangePreviewText(startISO, endISO, amt) {
      const dates = getDatesInRange(startISO, endISO);
      if (!dates.length) return '⚠️ সঠিক শুরুর ও শেষ তারিখ নির্বাচন করুন';
      const total = dates.length * Number(amt || 0);
      return `📅 ${formatDateBn(startISO)} থেকে ${formatDateBn(endISO)} পর্যন্ত<br>মোট দিন: <b>${toBn(dates.length)} দিন</b> • প্রতিদিন ৳ ${toBn(amt || 0)} = মোট <b>৳ ${toBn(total)}</b>`;
    }

    function updateRangePreview() {
      const s = document.getElementById('dep-range-start')?.value;
      const e = document.getElementById('dep-range-end')?.value;
      const a = Number(document.getElementById('dep-range-amount')?.value || 0);
      const box = document.getElementById('range-preview-box');
      if (box) box.innerHTML = buildRangePreviewText(s, e, a);
    }

    function addDeposit(memberId) {
      if (!requireAdmin()) return;
      const dateVal = document.getElementById('dep-date').value || getTodayISO();
      const amountVal = Number(document.getElementById('dep-amount').value);
      const noteVal = document.getElementById('dep-note').value.trim() || 'দৈনিক কিস্তি';

      if (!amountVal || amountVal <= 0) {
        showToast('সঠিক টাকার পরিমাণ লিখুন');
        return;
      }

      const member = db.members.find(m => m.id === memberId);
      if (!member) return;

      member.deposits.push({
        id: 'd_' + Date.now() + '_' + Math.floor(Math.random() * 10000),
        date: dateVal,
        amount: amountVal,
        note: noteVal
      });

      saveDatabase();
      showToast(`${member.name}-এর নামে ৳${toBn(amountVal)} অটো-আপডেট হয়েছে`);
      render();
    }

    function addRangeDeposit(memberId) {
      if (!requireAdmin()) return;
      const startISO = document.getElementById('dep-range-start').value;
      const endISO = document.getElementById('dep-range-end').value;
      const amountVal = Number(document.getElementById('dep-range-amount').value);
      const noteVal = document.getElementById('dep-range-note').value.trim() || 'দৈনিক কিস্তি';
      const skipDup = document.getElementById('dep-range-skip-dup').checked;

      const dates = getDatesInRange(startISO, endISO);
      if (!dates.length) {
        showToast('সঠিক শুরুর ও শেষ তারিখ দিন');
        return;
      }
      if (!amountVal || amountVal <= 0) {
        showToast('সঠিক টাকার পরিমাণ লিখুন');
        return;
      }

      const member = db.members.find(m => m.id === memberId);
      if (!member) return;

      const existingDates = new Set((member.deposits || []).map(d => d.date));
      let addedCount = 0;

      dates.forEach((dStr, idx) => {
        if (skipDup && existingDates.has(dStr)) return;
        member.deposits.push({
          id: 'd_' + Date.now() + '_' + idx + '_' + Math.floor(Math.random() * 1000),
          date: dStr,
          amount: amountVal,
          note: noteVal
        });
        addedCount++;
      });

      if (addedCount === 0) {
        showToast('এই তারিখগুলোতে আগেই জমা রয়েছে!');
        return;
      }

      saveDatabase();
      showToast(`${member.name}-এর ${toBn(addedCount)} দিনের (৳${toBn(addedCount * amountVal)}) জমা আপডেট হয়েছে!`);
      render();
    }

    function deleteDeposit(memberId, depositId) {
      if (!requireAdmin()) return;
      askConfirm('আপনি কি এই জমার হিসাবটি মুছে ফেলতে চান?', () => {
        const member = db.members.find(m => m.id === memberId);
        if (!member) return;
        member.deposits = member.deposits.filter(d => d.id !== depositId);
        saveDatabase();
        showToast('হিসাবটি মুছে ফেলা হয়েছে');
        render();
      });
    }

    function openEditMemberPrompt(memberId) {
      if (!requireAdmin()) return;
      const member = db.members.find(m => m.id === memberId);
      if (!member) return;
      const newName = prompt('সদস্যের নাম সংশোধন করুন:', member.name);
      if (newName === null) return;
      const newPhone = prompt('মোবাইল নম্বর সংশোধন করুন:', member.phone);
      if (newPhone === null) return;
      if (newName.trim()) member.name = newName.trim();
      if (newPhone.trim()) member.phone = newPhone.trim();
      saveDatabase();
      showToast('সদস্যের তথ্য আপডেট হয়েছে');
      render();
    }

    function deleteMember(memberId) {
      if (!requireAdmin()) return;
      const member = db.members.find(m => m.id === memberId);
      if (!member) return;
      askConfirm(`সতর্কতা: "${member.name}"-কে তালিকা থেকে মুছে ফেলতে চান? তার সকল জমার হিসাবও মুছে যাবে!`, () => {
