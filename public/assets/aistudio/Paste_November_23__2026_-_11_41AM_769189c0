    function toBn(num) {
      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return String(num).replace(/\d/g, d => bnDigits[d]);
    }

    function toEnDigits(str) {
      const bnDigits = ['০', '১', '২', '৩', '৪', '৫', '৬', '৭', '৮', '৯'];
      return String(str || '').replace(/[০-৯]/g, d => bnDigits.indexOf(d));
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function getTodayISO() {
      const now = new Date();
      const y = now.getFullYear();
      const m = String(now.getMonth() + 1).padStart(2, '0');
      const d = String(now.getDate()).padStart(2, '0');
      return `${y}-${m}-${d}`;
    }

    function formatDateBn(iso) {
      if (!iso) return '-';
      const parts = iso.split('-');
      if (parts.length !== 3) return iso;
      return `${toBn(parts[2])}/${toBn(parts[1])}/${toBn(parts[0])}`;
    }

    function getDatesInRange(startISO, endISO) {
      if (!startISO || !endISO || startISO > endISO) return [];
      const dates = [];
      const [sy, sm, sd] = startISO.split('-').map(Number);
      const [ey, em, ed] = endISO.split('-').map(Number);
      const current = new Date(Date.UTC(sy, sm - 1, sd));
      const end = new Date(Date.UTC(ey, em - 1, ed));
      let guard = 0;
      while (current <= end && guard < 366) {
        const cy = current.getUTCFullYear();
        const cm = String(current.getUTCMonth() + 1).padStart(2, '0');
        const cd = String(current.getUTCDate()).padStart(2, '0');
        dates.push(`${cy}-${cm}-${cd}`);
        current.setUTCDate(current.getUTCDate() + 1);
        guard++;
      }
      return dates;
    }

