  <script>
    // মূল HTML শেল ক্যাপচার
    const INITIAL_HTML_SHELL = '<!DOCTYPE html>\n' + document.documentElement.outerHTML;
    const STORAGE_KEY = 'barakah_multicare_unity_db_v2';
    const VIEW_STATE_KEY = 'barakah_unity_current_view_v1';

    let db = loadDatabase();
    let currentView = loadInitialViewState();
    let searchQuery = '';
    let isAdminAuthenticated = false;
    let pendingTargetAfterLogin = null;
    let confirmCallback = null;
    let aiUndoSnapshot = null;

    function getDefaultAppConfig() {
      return {
        homeTickerText: 'সম্মানিত সদস্যগনকে নিজ উদ্যোগে ডেইলি ডিপোজিট জমাদানের জন্য আহবান জানানো হচ্ছে।',
        bkashTickerText: 'দয়া করে সর্বনিম্ন ৫টি ডিপোজিট ও খরচ সহ বিকাশ করুন',
        bkashNumber: '01303768168',
        adminPhone: '01607703566',
        themeColor: '#0f766e',
        darkMode: false,
        noticeBanner: '',
        showLeaderboard: false,
        fundTarget: 0,
        sortBy: 'id',
        customCss: '',
        customWidgets: [],
        aiApiKey: '',
        aiProvider: 'gemini',
        aiLogs: []
      };
    }

    function ensureDbStructure(targetDb, defDb) {
      targetDb.appConfig = Object.assign(getDefaultAppConfig(), targetDb.appConfig || {});
      if (!Array.isArray(targetDb.appConfig.customWidgets)) targetDb.appConfig.customWidgets = [];
      if (!Array.isArray(targetDb.appConfig.aiLogs)) targetDb.appConfig.aiLogs = [];
      // ১৪ নং সদস্যের নামের সামনে "এডমিন " নিশ্চিত করা
      if (Array.isArray(targetDb.members)) {
        targetDb.members.forEach(m => {
          if (m.phone === '01607703566' && m.name.trim() === 'সোহাগ হোসেন') {
            m.name = 'এডমিন সোহাগ হোসেন';
          }
        });
      }
      if (!targetDb.appConfig.homeTickerText && defDb?.appConfig?.homeTickerText) {
        targetDb.appConfig.homeTickerText = defDb.appConfig.homeTickerText;
      }
      return targetDb;
    }

    function loadDatabase() {
      const defEl = document.getElementById('default-db');
      const defDb = ensureDbStructure(JSON.parse(defEl.textContent));
      try {
        const saved = localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          if (parsed && Array.isArray(parsed.members)) {
            if (Number(defDb.updatedAtMs || 0) > Number(parsed.updatedAtMs || 0)) {
              localStorage.setItem(STORAGE_KEY, JSON.stringify(defDb));
              setTimeout(() => showToast('নতুন আপডেট অটো লোড হয়েছে!'), 400);
              return defDb;
            }
            return ensureDbStructure(parsed, defDb);
          }
        }
      } catch (e) {}
      localStorage.setItem(STORAGE_KEY, JSON.stringify(defDb));
      return defDb;
    }

    function loadInitialViewState() {
      const fallback = {
        page: 'home',
        memberId: null,
        adminTab: 'ai',
        depositMode: 'single',
        paymentMethod: null
      };
      try {
        const raw = sessionStorage.getItem(VIEW_STATE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && parsed.page) {
            // অ্যাডমিন অথেনটিকেশন না থাকলে অ্যাডমিন/অ্যাড মেম্বার পেজ থেকে সেফলি হোমে নেবে, বাকি সব পেজ ঠিক রাখবে
            if (parsed.page === 'admin' || parsed.page === 'addMember') {
              return fallback;
            }
            return Object.assign(fallback, parsed);
          }
        }
      } catch (e) {}
      return fallback;
    }

    function persistViewState() {
      try {
        sessionStorage.setItem(VIEW_STATE_KEY, JSON.stringify(currentView));
      } catch (e) {}
    }

    function applyDynamicThemeAndCss() {
      const cfg = db.appConfig || getDefaultAppConfig();
      const root = document.documentElement;
      const color = cfg.themeColor || '#0f766e';
      root.style.setProperty('--primary', color);
      document.body.classList.toggle('dark-mode', Boolean(cfg.darkMode));
      const metaTheme = document.querySelector('meta[name="theme-color"]');
      if (metaTheme) metaTheme.setAttribute('content', color);

      const styleEl = document.getElementById('ai-custom-css');
      if (styleEl) styleEl.textContent = cfg.customCss || '';
    }

    function saveDatabase(skipCloudPush = false) {
      db.updatedAtMs = Date.now();
      db.lastBackup = new Date().toLocaleString('bn-BD');
      localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
      applyDynamicThemeAndCss();
      if (!skipCloudPush && db.cloudSyncUrl && isAdminAuthenticated) {
        pushToCloud(true);
      }
    }

    // ঐচ্ছিক ক্লাউড অটো-সিঙ্ক
    async function syncFromCloud(silent = true) {
      if (!db.cloudSyncUrl) {
        if (!silent) showToast('বর্তমান পেজটি লোকাল ডেটা থেকে আপডেট হয়েছে');
        return false;
      }
      try {
        const url = db.cloudSyncUrl.trim();
        const sep = url.includes('?') ? '&' : '?';
        const res = await fetch(`${url}${sep}_t=${Date.now()}`, { cache: 'no-store' });
        if (!res.ok) throw new Error('Network error');
        const remote = await res.json();
        if (remote && Array.isArray(remote.members)) {
          if (Number(remote.updatedAtMs || 0) > Number(db.updatedAtMs || 0)) {
            const keepUrl = db.cloudSyncUrl;
            db = ensureDbStructure(remote);
            if (!db.cloudSyncUrl) db.cloudSyncUrl = keepUrl;
            localStorage.setItem(STORAGE_KEY, JSON.stringify(db));
            applyDynamicThemeAndCss();
            render();
            showToast('নতুন তথ্য অটো আপডেট হয়েছে!');
            return true;
          } else if (!silent) {
            showToast('সব তথ্য ইতিমধ্যেই আপডেটেড আছে');
          }
        }
      } catch (e) {
        if (!silent) showToast('সার্ভার থেকে আপডেট চেক করা যায়নি');
      }
      return false;
    }

    async function pushToCloud(silent = true) {
      if (!db.cloudSyncUrl || !isAdminAuthenticated) return false;
      try {
        const res = await fetch(db.cloudSyncUrl.trim(), {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(db)
        });
        if (!res.ok) throw new Error('Push failed');
        if (!silent) showToast('ক্লাউডে ডেটা সফলভাবে আপডেট হয়েছে!');
        return true;
      } catch (e) {
        if (!silent) showToast('ক্লাউডে পাঠানো যায়নি, ফোনে সেভ আছে');
        return false;
      }
    }

    function requireAdmin() {
      if (isAdminAuthenticated) return true;
