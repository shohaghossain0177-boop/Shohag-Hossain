    function goBack() {
      if (stack.length > 1) stack.pop(); else stack = [{ page: 'home' }];
      try { window.scrollTo(0, 0); } catch (e) {}
      render();
    }
    window.addEventListener('popstate', () => { if (stack.length > 1) { stack.pop(); render(); } });
    window.addEventListener('keydown', (e) => {
      const modalOpen = document.getElementById('pin-modal').style.display === 'flex'
        || document.getElementById('popup-modal').style.display === 'flex'
        || document.getElementById('confirm-modal').style.display === 'flex';
      if (e.altKey && e.key === 'ArrowLeft') { e.preventDefault(); goBack(); }
      else if (e.key === 'Escape' && !modalOpen && stack.length > 1) goBack();
    });

    function openPin() {
      document.getElementById('pin-input').value = '';
      document.getElementById('pin-err').style.display = 'none';
      document.getElementById('pin-modal').style.display = 'flex';
      setTimeout(() => { try { document.getElementById('pin-input').focus(); } catch(e){} }, 80);
