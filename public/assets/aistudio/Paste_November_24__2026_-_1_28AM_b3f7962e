    label.flbl { display: block; font-size: 12px; font-weight: 700; color: var(--muted); margin-bottom: 4px; }

    /* Tabs & Progress */
    .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
